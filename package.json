{
  "name": "atelier",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first agent workspace: multi-conversation chat, file editing, git diffs, terminal, browser preview, and plans in one fast UI for any model API.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration tests/ui",
    "test:budgets": "node scripts/test-budgets.mjs",
    "lint": "oxlint src server scripts tests",
    "verify": "node scripts/verify.mjs",
    "help": "tsx server/main.ts --help",
    "doctor": "tsx server/main.ts --doctor",
    "health": "node scripts/health.mjs",
    "demo": "node scripts/demo.mjs",
    "dogfood": "node scripts/dogfood.mjs",
    "crash:test": "node scripts/crash-test.mjs",
    "bench": "node scripts/bench.mjs",
    "ui:inventory": "node scripts/ui-inventory.mjs",
    "ui:shots": "node scripts/ui-shots.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:a11y": "node scripts/test-a11y.mjs",
    "eval": "tsx scripts/eval.ts",
    "perf": "node scripts/bench.mjs",
    "eval:baseline": "tsx scripts/eval.ts --baseline",
    "eval:compare": "tsx scripts/eval-compare.ts",
    "eval:gate": "tsx scripts/eval-gate.ts",
    "engine:gaps": "tsx scripts/engine-gaps.ts",
    "eval:release": "tsx scripts/eval.ts --split test --release",
    "eval:quality": "tsx scripts/eval.ts --suite atelier-quality --split dev",
    "eval:quality:baseline": "tsx scripts/eval.ts --suite atelier-quality --split dev --baseline",
    "eval:quality:gate": "tsx scripts/eval-gate.ts --suite atelier-quality",
    "bench:compaction": "tsx scripts/compaction-bench.ts",
    "bench:checkpoint": "tsx scripts/checkpoint-bench.ts",
    "test:agent-perf": "tsx scripts/agent-perf.ts",
    "agent-perf:baseline": "tsx scripts/agent-perf.ts --update",
    "bench:agent": "tsx scripts/agent-bench.ts",
    "agent-bench:baseline": "tsx scripts/agent-bench.ts --update",
    "test:agent-bench": "tsx scripts/agent-bench.ts",
    "ui:before": "node scripts/ui-shots.mjs before",
    "ui:after": "node scripts/ui-shots.mjs after",
    "ui:panels": "node scripts/ui-panels.mjs",
    "ui:clickmap": "node scripts/ui-clickmap.mjs",
    "ui:composer": "node scripts/ui-composer-shots.mjs",
    "ui:audit": "node scripts/ui-audit.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "axe-core": "^4.14.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "oxlint": "^1.92.0",
    "playwright-core": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
