{
  "schema": 1,
  "kind": "ui",
  "has_ui": true,
  "commands": {
    "inventory": "node scripts/ui-inventory.mjs",
    "scripted": "node scripts/dogfood.mjs"
  },
  "seed": {
    "flag": "--seed",
    "replay_log": ".aikit/replay.log"
  },
  "bench": {
    "baseline": ".aikit/bench-baseline.json",
    "delta": ".aikit/bench-delta.json"
  },
  "evidence": {
    "schema": 1,
    "file": ".aikit/evidence.json"
  },
  "screenshots": {
    "dir": "shots",
    "before": "shots/atelier-before.png",
    "after": "shots/atelier-after.png"
  },
  "hooks": {
    "layout_map": ".aikit/layout-map.json",
    "clickmap": ".aikit/clickmap.log"
  }
}
